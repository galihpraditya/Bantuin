# ==============================================================================
# BANTUIN ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin berkas ini ke `.env` atau tambahkan variabel ke `local.properties`
# untuk konfigurasi lokal Android Studio.
#
# Di Android, variabel ini dimuat dari `local.properties` atau Environment Variables
# saat proses build Gradle:
#
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ==============================================================================

# URL endpoint REST & Realtime Supabase (dari Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Kunci publik Anon (aman ditaruh di sisi klien, diatur dengan aturan RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# (Opsional) Akun Demo Bawaan untuk Pengujian
DEMO_CUSTOMER_EMAIL=pelanggan1@bantuin.test
DEMO_CUSTOMER_PASSWORD=Demo12345!
DEMO_PROVIDER_EMAIL=mitra01@bantuin.test
DEMO_PROVIDER_PASSWORD=Demo12345!
